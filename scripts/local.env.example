# Connection details for scripts/deploy.sh, scripts/fetch-log.sh and scripts/ini-set.sh.
# Copy this file to scripts/local.env (gitignored) and edit the values there.
# Values already set in the environment win over the ones in scripts/local.env.

# The ssh target of the machine running the game (e.g. a Steam Deck with SSH enabled).
DECK_HOST="deck@steamdeck.local"

# The game folder on that machine. Optional; this is the default.
GAME_DIR="/home/deck/.local/share/Steam/steamapps/common/HITMAN 3"
